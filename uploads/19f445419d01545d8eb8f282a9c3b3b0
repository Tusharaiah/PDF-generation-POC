          "Helvetica Neue", sans-serif;
      }
    </style>
    <style type="text/css">
      /* -------------------------------------
          GLOBAL RESETS
      ------------------------------------- */

      /*All the styling goes here*/

      img {
        border: none;
        -ms-interpolation-mode: bicubic;
        max-width: 100%;
      }

      body,
      .main-wrapper {
        background-color: #f5f7fb;
        -webkit-font-smoothing: antialiased;
        -ms-text-size-adjust: 100%;
        -webkit-text-size-adjust: 100%;
        margin: 0;
        padding: 0;
        table-layout: fixed;
        border-spacing: 0;
        border-collapse: collapse;
        width: 100% !important;
        min-width: 100%;
        color: #0a0836;
        font-size: 14px;
        line-height: 1.5;
      }

      table {
        border-collapse: separate;
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
        width: 100%;
      }

      table td {
        font-size: 14px;
        vertical-align: top;
      }

      /* -------------------------------------
          BODY & CONTAINER
      ------------------------------------- */

      .body {
        background-color: transparent;
        width: 100%;
      }

      .container {
        display: block;
        margin: 0 auto !important;
        max-width: 600px;
        padding: 10px;
        width: 600px;
      }

      .content {
        box-sizing: border-box;
        display: block;
        margin: 0 auto;
        max-width: 600px;
        padding: 0;
      }

      /* -------------------------------------
          HEADER, FOOTER, MAIN
      ------------------------------------- */
      .main {
        background: #ffffff;
        border-radius: 3px;
        width: 100%;
      }

      .wrapper {
        box-sizing: border-box;
        padding: 30px;
        height: 616px;
      }

      .content-block {
        padding-bottom: 10px;
        padding-top: 10px;
      }

      .footer {
        clear: both;
        margin-top: 10px;
        text-align: center;
        width: 100%;
      }

      .footer td,
      .footer p,
      .footer span,
      .footer a {
        color: #838a92;
        font-size: 12px;
        text-align: center;
      }

      /* -------------------------------------
          TYPOGRAPHY
      ------------------------------------- */
      h1,
      h2,
      h3,
      h4 {
        color: #000000;
        font-weight: 400;
        line-height: 1.4;
        margin: 0;
        margin-bottom: 30px;
      }

      h1 {
        font-size: 35px;
        font-weight: 300;
        text-align: center;
        text-transform: capitalize;
      }

      p,
      ul,
      ol {
        font-size: 16px;
        font-weight: 400;
        color: #131414;
        margin: 0;
        margin-bottom: 16px;
      }

      p li,
      ul li,
      ol li {
        list-style-position: inside;
        margin-left: 5px;
      }

      a {
        color: #f16617;
        text-decoration: none;
        font-weight: 400;
      }

      a:hover {
        color: #000000;
      }

      /* -------------------------------------
          BUTTONS
      ------------------------------------- */
      .btn {
        box-sizing: border-box;
        width: 100%;
      }

      .btn > tbody > tr > td {
        padding-bottom: 15px;
      }

      .btn table td {
        background-color: #ffffff;
        border-radius: 0;
        text-align: center;
      }

       .btn a {
      background-color: #ffffff;
      border: solid 0 #F16617;
      border-radius: 0;
      box-sizing: border-box;
      color: #F16617;
      cursor: pointer;
      display: inline-block;
      font-size: 14px;
      font-weight: 400;
      margin: 15px 0;
      padding: 12px 25px;
      min-width: 190px;
      text-align: center;
      text-decoration: none;
      text-transform: capitalize;
    }

      .btn a:hover {
        background-color: #000000;
      }

      .btn.btn-block a {
        display: block;
        text-align: center;
      }

      .btn-primary table td {
        background-color: #f16617;
      }

      .btn-primary a {
        background-color: #f16617;
        border-color: #f16617;
        color: #ffffff;
      }

      /* -------------------------------------
          OTHER STYLES THAT MIGHT BE USEFUL
      ------------------------------------- */

      .powered-by {
        padding: 20px 0 50px;
      }

      .powered-by a {
        text-decoration: none;
        padding-top: 30px;
      }

      hr {
        border: 0;
        border-bottom: 1px solid #f6f6f6;
        margin: 20px 0;
      }

      /* -------------------------------------
          RESPONSIVE AND MOBILE FRIENDLY STYLES
      ------------------------------------- */
      @media only screen and (max-width: 620px) {
        table.body h1 {
          font-size: 28px !important;
          margin-bottom: 10px !important;
        }

        table.body p,
        table.body ul,
        table.body ol,
        table.body td,
        table.body span,
        table.body a {
          font-size: 16px !important;
        }

        table.body .wrapper,
        table.body .article {
          padding: 10px !important;
        }

        table.body .content {
          padding: 0 !important;
        }

        table.body .container {
          padding: 0 !important;
          width: 100% !important;
        }

        table.body .main {
          border-left-width: 0 !important;
          border-radius: 0 !important;
          border-right-width: 0 !important;
        }

        table.body .btn table {
          width: 100% !important;
        }

        table.body .btn a {
          width: 100% !important;
        }

        table.body .img-responsive {
          height: auto !important;
          max-width: 100% !important;
          width: auto !important;
        }
      }

      /* -------------------------------------
          PRESERVE THESE STYLES IN THE HEAD
      ------------------------------------- */
      @media all {
        .ExternalClass {
          width: 100%;
        }

        .ExternalClass,
        .ExternalClass p,
        .ExternalClass span,
        .ExternalClass font,
        .ExternalClass td,
        .ExternalClass div {
          line-height: 100%;
        }

        .apple-link a {
          color: inherit !important;
          font-family: inherit !important;
          font-size: inherit !important;
          font-weight: inherit !important;
          line-height: inherit !important;
          text-decoration: none !important;
        }

        #MessageViewBody a {
          color: inherit;
          text-decoration: none;
          font-size: inherit;
          font-family: inherit;
          font-weight: inherit;
          line-height: inherit;
        }

        .btn-primary table td:hover {
          background-color: #34495e !important;
        }

        .btn-primary a:hover {
          background-color: #34495e !important;
          border-color: #34495e !important;
        }
      }

      /*  OUR CUSTOM CSS */
      .logo-wrapper {
        text-align: center;
        padding: 50px 0 20px;
      }

      .logo-wrapper .logo-image {
        width: 112px;
      }

      .verification-time {
        color: #505a66;
        font-size: 14px;
        line-height: normal;
        text-align: left;
        margin-top: 0;
      }

      .otpcode {
        text-align: left;
        font-weight: 300;
        font-size: 36px;
        line-height: 40px;
        padding-bottom: 0.5rem;
        margin-bottom: 0;
      }

      p.high {
        font-size: 20px;
      }

      .heading-icon {
        text-align: center;
        padding: 0 0 16px;
      }

      .heading {
        font-size: 30px;
        font-weight: 300;
        line-height: 40px;
        text-align: center;
        margin-bottom: 24px;
      }

      .divider {
        border: 1px solid #e6eaee;
        margin-bottom: 32px;
      }

      .otp-wrapper {
        margin: 1.5rem 0;
      }

      .mb0 {
        margin-bottom: 0;
      }
      .creds-width {
        margin-top: 8px;
      }

      .creds-label {
        min-width: 200px;
        display: inline-block;
      }

      .password-info {
        color: #131414;
        font-size: 14px;
        line-height: 30px;
      }
    </style>
  </head>

  <body>
    <div class="main-wrapper">
      <div class="logo-wrapper">
        <img
          src="https://owner-portal-dev-public.s3.ap-south-1.amazonaws.com/assets/logos/owner-portal-logo.png"
          class="logo-image"
          alt="henery logo"
        />
      </div>

      <table
        role="presentation"
        border="0"
        cellpadding="0"
        cellspacing="0"
        class="body"
      >
        <tr>
          <td>&nbsp;</td>
          <td class="container">
            <div class="content">
              <!-- START CENTERED WHITE CONTAINER -->
              <table role="presentation" class="main">
                <!-- START MAIN CONTENT AREA -->
                <tr>
                  <td class="wrapper">
                    <table
                      role="presentation"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                    >
                      <tr>
                        <td>
                          <div class="heading-icon">
                            <img
                              src="https://owner-portal-dev-public.s3.ap-south-1.amazonaws.com/assets/logos/security-logo.png"
                              alt="security notice"
                            />
                          </div>
                          <h2 class="heading">Reset Password</h2>
                          <div class="divider"></div>
                          <p class="high">Hi {{firstName}},</p>
                          <p>
                            Your password has been changed by your Admin. Next
                            time login with your new credentials.
                          </p>
                          <br />
                          <p class="creds-width">
                            <span class="creds-label">Email</span>
                            <span class="creds-value">{{email}}</span>
                          </p>
                          <p class="creds-width">
                            <span class="creds-label">Password</span>
                            <span class="creds-value">{{ password }}</span>
                          </p>

                          <div class="btn btn-primary">
                            <a href="{{frontendUrl}}" target="_blank">
                              Login
                            </a>
                          </div>

                          <br />
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- END MAIN CONTENT AREA -->
              </table>
              <!-- END CENTERED WHITE CONTAINER -->

              <!-- START FOOTER -->
              <div class="footer">
                <table
                  role="presentation"
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                >
                  <tr>
                    <td class="content-block powered-by">
                      ©️ Copyright <span id="year"></span> Henry.com
                    </td>
                  </tr>
                </table>
              </div>
              <!-- END FOOTER -->
            </div>
          </td>
          <td>&nbsp;</td>
        </tr>
      </table>
    </div>
  </body>

  <script>
    var date = new Date().getFullYear();
    document.getElementById("year").innerHTML = date;
  </script>
</html>
