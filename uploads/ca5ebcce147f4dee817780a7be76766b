<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title>HENRY | Funds Deposited</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400&display=swap"
      rel="stylesheet"
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <style type="text/css">
      :root {
        color-scheme: light dark;
        supported-color-schemes: light dark;
      }

      @media (prefers-color-scheme: light) {
        .dark-mode {
          display: none !important;
        }
        .light-mode {
          display: inline !important;
        }
        body,
        .main-wrapper {
          background-color: #f5f7fb;
          color: #020202;
        }
        .main-wrapper a {
          color: #3679f2;
        }
        .main-wrapper a:hover {
          color: #3370de;
        }
        .btn a {
          background-color: #ffffff;
          border: solid 0 #3679f2;
          color: #3679f2;
        }
        .btn-primary table td {
          background-color: #3679f2;
        }
        .btn-primary a {
          background-color: #3679f2;
          border-color: #3679f2;
          color: #ffffff;
        }

        .btn-primary a:hover {
          background-color: #3370de;
          border-color: #3370de;
          color: #ffffff;
        }
        .transaction-info {
          background: #fafbff;
        }
      }
      /* uncomment the following line for bother light and dark mode either its will work only for dark mode */
      /* @media (prefers-color-scheme: dark) { */
      .dark-mode {
        display: inline !important;
      }
      .light-mode {
        display: none !important;
      }
      body,
      .main-wrapper {
        background-color: #f5f7fb;
        color: #020202;
      }
      .main-wrapper a {
        color: #0086a4;
      }
      .main-wrapper a:hover {
        color: #00bebe;
      }

      .btn a {
        background-color: #ffffff;
        border: solid 0 #0086a4;
        color: #0086a4;
      }

      .btn-primary table td {
        background-color: #0086a4;
      }

      .btn-primary a {
        background-color: #0086a4;
        border-color: #0086a4;
        color: #ffffff;
      }

      .btn-primary a:hover {
        background-color: #006886;
        border-color: #006886;
        color: #ffffff;
      }
      .transaction-info {
        background: rgba(0, 134, 164, 0.1);
      }

      /* } */
    </style>

    <style type="text/css">
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400&display=swap");

      p,
      h1,
      h2,
      h3,
      h4,
      ol,
      li,
      div,
      ul,
      a,
      span,
      .powered-by {
        font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI",
          "Roboto", "Oxygen", "Ubuntu", "Cantarell", "Fira Sans", "Droid Sans",
          "Helvetica Neue", sans-serif;
      }
    </style>
    <style type="text/css">
      /* -------------------------------------
          GLOBAL RESETS
      ------------------------------------- */

      /*All the styling goes here*/

      img {
        border: none;
        -ms-interpolation-mode: bicubic;
        max-width: 100%;
      }

      body,
      .main-wrapper {
        -webkit-font-smoothing: antialiased;
        -ms-text-size-adjust: 100%;
        -webkit-text-size-adjust: 100%;
        margin: 0;
        padding: 0;
        table-layout: fixed;
        border-spacing: 0;
        border-collapse: collapse;
        width: 100% !important;
        min-width: 100%;
        color: #0a0836;
        font-size: 14px;
        line-height: 1.5;
      }

      table {
        border-collapse: separate;
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
        width: 100%;
      }

      table td {
        font-size: 14px;
        vertical-align: top;
      }

      /* -------------------------------------
          BODY & CONTAINER
      ------------------------------------- */

      .body {
        background-color: transparent;
        width: 100%;
      }

      .container {
        display: block;
        margin: 0 auto !important;
        max-width: 600px;
        padding: 0;
        width: 600px;
      }

      .content {
        box-sizing: border-box;
        display: block;
        margin: 0 auto;

        padding: 0;
      }

      /* -------------------------------------
          HEADER, FOOTER, MAIN
      ------------------------------------- */
      .main {
        background: #ffffff;
        border-radius: 8px;
        width: 100%;
      }

      .wrapper {
        box-sizing: border-box;
        padding: 40px;
        height: 616px;
        max-width: 596px;
        width: 100%;
      }

      .content-block {
        padding-bottom: 10px;
        padding-top: 10px;
      }

      .footer {
        clear: both;
        margin-top: 10px;
        text-align: center;
        width: 100%;
      }

      .footer td,
      .footer p,
      .footer span,
      .footer a {
        color: #838a92;
        font-size: 12px;
        text-align: center;
      }

      /* -------------------------------------
          TYPOGRAPHY
      ------------------------------------- */
      h1,
      h2,
      h3,
      h4 {
        color: #020202;
        font-weight: 400;
        line-height: 1.4;
        margin: 0;
        margin-bottom: 30px;
      }

      h1 {
        font-size: 35px;
        font-weight: 300;
        text-align: center;
        text-transform: capitalize;
      }

      p,
      ul,
      ol {
        font-size: 16px;
        font-weight: 400;
        color: #020202;
        margin: 0;
        margin-bottom: 16px;
        line-height: 24px;
      }

      p li,
      ul li,
      ol li {
        list-style-position: inside;
        margin-left: 5px;
      }

      a {
        text-decoration: none;
        font-weight: 400;
      }

      a:hover {
        color: #020202;
      }

      /* -------------------------------------
          BUTTONS
      ------------------------------------- */
      .btn {
        box-sizing: border-box;
        width: 100%;
      }

      .btn > tbody > tr > td {
        padding-bottom: 15px;
      }

      .btn table td {
        background-color: #ffffff;
        border-radius: 0;
        text-align: center;
      }

      .btn a {
        border-radius: 8px;
        box-sizing: border-box;
        cursor: pointer;
        display: inline-block;
        font-size: 14px;
        font-weight: 600;
        margin: 16px 0 16px;
        padding: 10px 25px;
        text-decoration: none;
        min-width: 190px;
        text-align: center;
        text-transform: capitalize;
      }

      .btn.btn-block a {
        display: block;
        text-align: center;
      }

      /* -------------------------------------
          OTHER STYLES THAT MIGHT BE USEFUL
      ------------------------------------- */

      .powered-by {
        padding: 20px 0 50px;
      }

      .powered-by a {
        text-decoration: none;
        padding-top: 30px;
      }

      hr {
        border: 0;
        border-bottom: 1px solid #f6f6f6;
        margin: 20px 0;
      }

      /* -------------------------------------
          RESPONSIVE AND MOBILE FRIENDLY STYLES
      ------------------------------------- */
      @media only screen and (max-width: 620px) {
        table.body h1 {
          font-size: 28px !important;
          margin-bottom: 10px !important;
        }

        table.body p,
        table.body ul,
        table.body ol,
        table.body td,
        table.body span,
        table.body a {
          font-size: 16px !important;
        }

        table.body .wrapper,
        table.body .article {
          padding: 10px !important;
        }

        table.body .content {
          padding: 0 !important;
        }

        table.body .container {
          padding: 0 !important;
          width: 100% !important;
        }

        table.body .main {
          border-left-width: 0 !important;
          border-radius: 0 !important;
          border-right-width: 0 !important;
        }

        table.body .btn table {
          width: 100% !important;
        }

        table.body .btn a {
          width: 100% !important;
        }

        table.body .img-responsive {
          height: auto !important;
          max-width: 100% !important;
          width: auto !important;
        }
      }

      /* -------------------------------------
          PRESERVE THESE STYLES IN THE HEAD
      ------------------------------------- */
      @media all {
        .ExternalClass {
          width: 100%;
        }

        .ExternalClass,
        .ExternalClass p,
        .ExternalClass span,
        .ExternalClass font,
        .ExternalClass td,
        .ExternalClass div {
          line-height: 100%;
        }

        .apple-link a {
          color: inherit !important;
          font-family: inherit !important;
          font-size: inherit !important;
          font-weight: inherit !important;
          line-height: inherit !important;
          text-decoration: none !important;
        }

        #MessageViewBody a {
          color: inherit;
          text-decoration: none;
          font-size: inherit;
          font-family: inherit;
          font-weight: inherit;
          line-height: inherit;
        }
      }

      /*  OUR CUSTOM CSS */
      .logo-wrapper {
        text-align: center;
        padding: 50px 0 20px;
      }

      .logo-wrapper .logo-image {
        width: 45px;
      }

      .otpcode {
        text-align: left;
        font-weight: 300;
        font-size: 32px;
        line-height: 48px;
        padding: 16px 0 4px;
        margin-bottom: 0;
      }

      .verification-time {
        color: #838a92;
        font-size: 14px;
        line-height: normal;
        text-align: left;
      }

      p.high {
        font-size: 20px;
      }

      .heading-icon {
        text-align: center;
        padding: 0 0 16px;
      }

      .heading {
        font-size: 32px;
        font-weight: 300;
        line-height: 48px;
        text-align: center;
        margin-bottom: 24px;
      }

      .divider {
        border: 1px solid #e5e5e5;
        margin-bottom: 24px;
      }

      .otp-wrapper {
        margin: 1.5rem 0;
      }

      .mb0 {
        margin-bottom: 0;
      }

      .mb32 {
        margin-bottom: 32px;
      }

      .transaction-info {
        padding: 24px;
        margin: 0 0 16px;
        border-radius: 8px;
        max-width: calc(516px - 50px);
        width: 100%;
      }

      .t-title {
        font-size: 16px;
        line-height: 22px;
        font-weight: 400;
        color: #020202;
      }

      .t-wrap {
        font-weight: 400;
        font-size: 14px;
        line-height: 20px;
        color: #020202;
      }
      .t-wrap tbody{
        width: 100%;
      }
      .t-wrap .label {
        display: inline-block;
        white-space: pre;
      }
      .t-wrap .value {
        float: right;
        display: inline-block;
        vertical-align: top;
        text-align: right;
      }

      .portfolio-label {
        max-width: 300px;
        margin-right: 10px;
        display: inline-block;
      }

      .t-wrap + .t-wrap {
        margin-top: 8px;
      }

      .t-wrap.head {
        font-size: 16px;
        line-height: 22px;
      }

      .t-wrap.bold {
        font-weight: 600;
      }
    </style>
  </head>

  <body>
    <div class="main-wrapper">
      <div class="logo-wrapper">
        <img
          src="https://exchange-dev-images.s3.ap-south-1.amazonaws.com/logo-main.png"
          class="light-mode logo-image"
          alt="henery logo"
        />
        <img
          src="https://exchange-dev-public.s3.ap-south-1.amazonaws.com/assets/logos/logo-dark-mode.png"
          class="dark-mode logo-image"
          alt="henery logo"
        />
      </div>

      <table
        role="presentation"
        border="0"
        cellpadding="0"
        cellspacing="0"
        class="body"
      >
        <tr>
          <td>&nbsp;</td>
          <td class="container">
            <div class="content">
              <!-- START CENTERED WHITE CONTAINER -->
              <table role="presentation" class="main">
                <!-- START MAIN CONTENT AREA -->
                <tr>
                  <td class="wrapper">
                    <table
                      role="presentation"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                    >
                      <tr>
                        <td>
                          <div class="heading-icon">
                            <img
                              src="https://exchange-dev-public.s3.ap-south-1.amazonaws.com/assets/logos/fund-withdrawn.png"
                              alt=""
                              class="light-mode"
                            />
                            <img
                              src="https://exchange-dev-public.s3.ap-south-1.amazonaws.com/assets/logos/success-dark.png"
                              alt=""
                              class="dark-mode"
                            />
                          </div>
                          <h2 class="heading">Funds Deposited</h2>
                          <div class="divider"></div>
                          <p class="high">Hi {{firstName}},</p>
                          <p class="mb32">
                            Congratulations your funds have been successfully
                            Deposited to your HENRY Account! You can now start
                            to purchase shares of real assets instantaneously.
                          </p>

                          <div class="transaction-info">
                            <p class="t-title">{{depositTitle}} Summary</p>
                            <table class="t-wrap" id="portfolioDiv">
                              <tr class="t-wrap" id="portfolioDiv">
                                {{#if displayPortfolio}}
                                <td><span class="label">Portfolio</span></td>
                                <td><span class="value">{{portfolioValue}}</span></td>
                                {{/if}}
                              </tr>
                              <tr class="t-wrap">
                                {{#if source}}
                                <td><span class="label">Source</span></td>
                                <td><span class="value">{{source}}</span></td>
                                {{/if}}
                              </tr>
                              <tr class="t-wrap">
                                <td><span class="label">Destination</span></td>
                                <td><span class="value">{{destination}}</span></td>
                              </tr>
                              <tr class="t-wrap bold">
                                <td><span class="label">Total Amount</span></td>
                                <td><span class="value">${{formatAmount amount}}</span></td>
                              </tr>
                            </table>
                          </div>
                          <div class="btn btn-primary">
                            <a href="{{url}}" target="_blank">
                              View Portfolio
                            </a>
                          </div>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- END MAIN CONTENT AREA -->
              </table>
              <!-- END CENTERED WHITE CONTAINER -->

              <!-- START FOOTER -->
              <div class="footer">
                <table
                  role="presentation"
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                >
                  <tr>
                    <td class="content-block powered-by">
                      ©️ Copyright <span id="year"></span> Henry.com
                    </td>
                  </tr>
                </table>
              </div>
              <!-- END FOOTER -->
            </div>
          </td>
          <td>&nbsp;</td>
        </tr>
      </table>

      
    </div>
  </body>

  <script>
    var date = new Date().getFullYear();
    document.getElementById("year").innerHTML = date;

    // var displayPortfolio = {{displayPortfolio}}; // Assuming displayPortfolio is a boolean value

    // // Check the dynamic condition
    // if (!displayPortfolio) {
    //   // If the condition is not met, hide the portfolioDiv
    //   document.getElementById('portfolioDiv').style.display = 'none';
    // }
  </script>
</html>
